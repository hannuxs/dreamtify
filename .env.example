# =====================================================================
# Konfigurasi Dreamtify
# Salin ke .env (dev.bat / install.bat melakukannya otomatis dan
# mengisi nilai acak). JANGAN commit file .env.
# =====================================================================

# --- Umum ------------------------------------------------------------
SECRET_KEY=ganti-dengan-nilai-acak
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8383,http://127.0.0.1:8383
SITE_URL=http://localhost:8383
TIME_ZONE=Asia/Jakarta
HTTPS=0
TRUSTED_PROXY=0

# --- Web -------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8383
WAITRESS_THREADS=8

# --- Database (MariaDB) ---------------------------------------------
# Boleh di server lain. Setelah mengubah nilai di bawah, jalankan ulang web
# (prod.bat / dev.bat / scripts\layanan.ps1 restart): database & semua tabel
# dibuat otomatis. Data lama tidak ikut pindah.
DB_HOST=127.0.0.1
DB_PORT=3309
# DB_NAME     = database SUNGGUHAN, dipakai prod.bat / install.bat
# DB_NAME_DEV = database COBA-COBA, dipakai dev.bat (boleh data demo)
DB_NAME=dreamtify
DB_NAME_DEV=dreamtify_dev
DB_USER=dreamtify
# Sandi berisi spasi atau # diapit tanda kutip: DB_PASSWORD='sandi #1'
# Sandi tidak boleh diawali tanda $
DB_PASSWORD=ganti-dengan-nilai-acak
# Pustaka Python penghubung ke MariaDB. Biarkan mysqlclient.
# pymysql hanya cadangan bila mysqlclient gagal dipasang (installer mengaturnya).
DB_DRIVER=mysqlclient
# Hanya untuk database di server lain: path file sertifikat CA server MariaDB.
# Dibutuhkan bila muncul error 2026 (sertifikat tidak terverifikasi).
DB_SSL_CA=
# Folder bin MariaDB (untuk backup/restore); kosong = deteksi otomatis.
# Bila MariaDB di server lain, tetap butuh program mariadb-dump di komputer web.
MARIADB_BIN=

# --- Keamanan data (SIMPAN SALINANNYA DI TEMPAT AMAN!) ----------------
# Kehilangan FIELD_ENCRYPTION_KEYS = NIK & rekening tidak bisa dibaca lagi.
# Beberapa kunci dipisah koma: kunci pertama untuk enkripsi, semua untuk dekripsi.
FIELD_ENCRYPTION_KEYS=ganti-dengan-kunci-fernet
NIK_HASH_PEPPER=ganti-dengan-nilai-acak

# --- Email (opsional) -------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Dreamtify <noreply@localhost>

# --- Backup ----------------------------------------------------------
BACKUP_DIR=backups
BACKUP_KEEP=14
